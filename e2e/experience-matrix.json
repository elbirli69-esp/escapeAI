      "label": "Diversión",
      "description": "Ritmo, narrativa, sensación de juego"
    },
    {
      "id": "challenge",
      "label": "Reto",
      "description": "Profundidad y fricción recuperable"
    },
    {
      "id": "variety",
      "label": "Variedad",
      "description": "Mecánicas y escenas distintas"
    },
    {
      "id": "flow",
      "label": "Fluidez UX",
      "description": "UI, errores, permisos"
    },
    {
      "id": "closure",
      "label": "Cierre",
      "description": "Victoria y payoff narrativo"
