# API local
PORT=8787
SESSION_DATA_DIR=./data/sessions

# Producción (Upstash): consola usa UPSTASH_*; Vercel Storage suele inyectar KV_REST_API_*
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# SESSION_TTL_SEC=172800

# Narrador IA (DeepSeek como StorIAteller — API OpenAI-compatible)
DEEPSEEK_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat
# Alternativa OpenAI directa:
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Orígenes extra (producción: dominio custom)
# CORS_ORIGINS=https://escapeai.example.com,https://www.escapeai.example.com
