{
  "name": "escapeai",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:e2e": "pnpm --filter @escapeai/e2e run e2e",
    "test:e2e:ui": "pnpm --filter @escapeai/e2e run e2e:ui",
    "playtest:replay": "pnpm --filter @escapeai/e2e run playtest:replay",
    "playtest:partidas": "pnpm --filter @escapeai/e2e exec playwright test specs/partidas-reales-runner.spec.ts",
    "playtest:facts-diff": "pnpm --filter @escapeai/escape-content run facts-diff",
    "playtest:snapshot": "pnpm --filter @escapeai/e2e run playtest:snapshot",
    "experience-eval:signals": "pnpm --filter @escapeai/e2e run experience:signals",
    "experience-eval:score": "pnpm --filter @escapeai/e2e run experience:score",
    "experience-eval:report": "pnpm --filter @escapeai/e2e run experience:report",
    "experience-eval": "pnpm build && pnpm experience-eval:signals && pnpm test:e2e && pnpm experience-eval:score && pnpm experience-eval:report",
    "validate-rooms": "pnpm --filter @escapeai/escape-content run validate-rooms",
    "audit-coherence": "pnpm --filter @escapeai/escape-content run audit-coherence",
    "audit-fisico": "pnpm --filter @escapeai/escape-content run audit-fisico",
    "dev": "pnpm --parallel --filter @escapeai/api --filter @escapeai/web run dev",
    "dev:api": "pnpm --filter @escapeai/api run dev",
    "dev:web": "pnpm --filter @escapeai/web run dev",
    "typecheck": "pnpm -r run typecheck"
  },
  "dependencies": {
    "hono": "^4.6.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0"
}
